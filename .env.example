# ==========================================
# OpsPulse Environment Configuration
# ==========================================

# --- Django Backend ---
DJANGO_SECRET_KEY=insecure-development-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL for Docker, SQLite fallback for local dev)
DATABASE_URL=postgres://opspulse:opspulse_secret@postgres:5432/opspulse_db
USE_SQLITE=False

# Celery & Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=OpsPulse
